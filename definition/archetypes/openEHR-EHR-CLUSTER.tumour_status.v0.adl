archetype (adl_version=1.4; uid=2cef39c3-3ce8-4233-a51b-3e4aa7dd80bb)
	openEHR-EHR-CLUSTER.tumour_status.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::de]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
				["name"] = <"Liv Laugen">
				["organisation"] = <"Oslo universitetssykehus">
